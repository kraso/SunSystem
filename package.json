{
  "name": "sun-system",
  "version": "0.1.0",
  "description": "Simulación 3D interactiva del Sistema Solar con física orbital realista",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint:fix": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "lil-gui": "^0.19.2",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
